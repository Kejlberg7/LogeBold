    "recalc": "tsx --env-file=.env.local scripts/recalc.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "postgres": "^3.4.9",
